<!--
    PSYstrap theme: layered on top of WPF UI's Dark dictionary.
    Palette sampled from the logo: green star (#2FB52A / #5FE04C / #8CF07B), crown red (#E8213F) and gold (#F2C14E).
    WPF UI builds its brushes from colours with StaticResource, so each overridden colour also gets its brush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls">
    <!-- logo palette, for PSYstrap-specific UI -->
    <Color x:Key="PsyGreenColor">#5FE04C</Color>
    <Color x:Key="PsyDeepGreenColor">#1A7F22</Color>
    <Color x:Key="PsyCrownRedColor">#E8213F</Color>
    <Color x:Key="PsyCrownGoldColor">#F2C14E</Color>
    <SolidColorBrush x:Key="PsyGreenBrush" Color="{StaticResource PsyGreenColor}" />
    <SolidColorBrush x:Key="PsyCrownRedBrush" Color="{StaticResource PsyCrownRedColor}" />
    <SolidColorBrush x:Key="PsyCrownGoldBrush" Color="{StaticResource PsyCrownGoldColor}" />

    <!-- crown-coloured strip used as a section accent -->
    <LinearGradientBrush x:Key="PsyCrownStripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#F2C14E" />
        <GradientStop Offset="0.5" Color="#E8213F" />
        <GradientStop Offset="1" Color="#F2C14E" />
    </LinearGradientBrush>

    <!-- window background: dark green with a soft green glow top-left and a faint crown-red glow bottom-right -->
    <DrawingBrush x:Key="PsyWindowBackgroundBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FF10251A" />
                            <GradientStop Offset="0.55" Color="#FF0A170E" />
                            <GradientStop Offset="1" Color="#FF070F09" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.05,0" GradientOrigin="0.05,0" RadiusX="0.75" RadiusY="1.1">
                            <GradientStop Offset="0" Color="#3036C42E" />
                            <GradientStop Offset="1" Color="#0036C42E" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.55" RadiusY="0.8">
                            <GradientStop Offset="0" Color="#1CE8213F" />
                            <GradientStop Offset="1" Color="#00E8213F" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- WPF UI overrides -->
    <Color x:Key="ApplicationBackgroundColor">#FF0A170E</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF0A170E" />

    <Color x:Key="SolidBackgroundFillColorBase">#0A170E</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#08120B</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#102217</Color>
    <Color x:Key="SolidBackgroundFillColorQuarternary">#14291C</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0A170E" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#08120B" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#102217" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#14291C" />

    <Color x:Key="CardBackgroundFillColorDefault">#1283E07A</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#0A83E07A</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1283E07A" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#0A83E07A" />

    <Color x:Key="ControlFillColorDefault">#1483E07A</Color>
    <Color x:Key="ControlFillColorSecondary">#1E83E07A</Color>
    <Color x:Key="ControlFillColorTertiary">#0A83E07A</Color>
    <Color x:Key="ControlFillColorInputActive">#E00C1A10</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1483E07A" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1E83E07A" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0A83E07A" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#E00C1A10" />

    <Color x:Key="SubtleFillColorSecondary">#1483E07A</Color>
    <Color x:Key="SubtleFillColorTertiary">#0C83E07A</Color>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1483E07A" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0C83E07A" />

    <Color x:Key="ControlStrokeColorDefault">#2263D457</Color>
    <Color x:Key="DividerStrokeColorDefault">#2449C23A</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2263D457" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2449C23A" />

    <Color x:Key="LayerFillColorDefault">#5010261A</Color>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#5010261A" />

    <!-- warnings/errors take the crown colours -->
    <Color x:Key="SystemFillColorCaution">#F2C14E</Color>
    <Color x:Key="SystemFillColorCritical">#FF5A6E</Color>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF5A6E" />

    <!-- keys the bootstrapper theme editor expects (same as Dark.xaml, green links) -->
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#0E1D12" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#5FE04C" />

    <!-- hand-drawn look: marker fonts, wobbly outlines, hatching (Dark.xaml/Light.xaml have the plain values) -->
    <sys:Double x:Key="PsySketchRoughness">1.8</sys:Double>
    <sys:Double x:Key="PsyCardStrokeThickness">2.5</sys:Double>
    <sys:Double x:Key="PsyNavBoxThickness">2.5</sys:Double>
    <SolidColorBrush x:Key="PsyCardStrokeBrush" Color="#27B52B" />
    <FontFamily x:Key="PsyMarkerFont">pack://application:,,,/Resources/Fonts/#Permanent Marker</FontFamily>
    <FontFamily x:Key="PsyHandFont">pack://application:,,,/Resources/Fonts/#Patrick Hand</FontFamily>
    <sys:Double x:Key="PsyCardTitleSize">17</sys:Double>
    <SolidColorBrush x:Key="PsyCardTitleBrush" Color="#3CF02A" />
    <sys:Double x:Key="PsyPageTitleSize">34</sys:Double>
    <SolidColorBrush x:Key="PsyPageTitleBrush" Color="#3CF02A" />
    <sys:Double x:Key="PsyPageTitleAngle">-2</sys:Double>
    <sys:Double x:Key="PsyNavFontSize">19</sys:Double>
    <sys:Boolean x:Key="PsyHatch">True</sys:Boolean>
    <SolidColorBrush x:Key="PsyPrimaryForeground" Color="#062A08" />

    <!-- toggle switches: hatched green when on, an empty marker outline when off -->
    <Style TargetType="{x:Type ui:ToggleSwitch}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="58" Height="30">
                            <controls:SketchBorder x:Name="OffTrack" Roughness="1.4" CornerRadius="14" BorderThickness="2.5" Background="#0B1A0F" BorderBrush="#7D9E80" />
                            <controls:SketchBorder x:Name="OnTrack" Roughness="1.4" CornerRadius="14" BorderThickness="2.5" Hatched="True" BorderBrush="#17761D" Visibility="Collapsed" />
                            <Ellipse x:Name="Knob" Width="18" Height="18" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="#7D9E80" StrokeThickness="2.5" Fill="Transparent" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OffTrack" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OnTrack" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Width" Value="20" />
                            <Setter TargetName="Knob" Property="Height" Value="20" />
                            <Setter TargetName="Knob" Property="Fill" Value="#F6E7A6" />
                            <Setter TargetName="Knob" Property="Stroke" Value="#07120A" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OffTrack" Property="BorderBrush" Value="#B6D3B6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DropShadowEffect x:Key="PsyTitleEffect" Color="#17761D" BlurRadius="0" ShadowDepth="3" Direction="315" Opacity="1" />

    <!-- WPF UI buttons drawn with a marker: sketched outline, hatched green for Success (Primary is every button's default, so it stays outlined), no box for Transparent -->
    <Style TargetType="{x:Type ui:Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="#EEF8EC" />
        <Setter Property="Background" Value="#0F2214" />
        <Setter Property="BorderBrush" Value="#27B52B" />
        <Setter Property="FontFamily" Value="{DynamicResource PsyMarkerFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,6,14,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <controls:SketchBorder x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="2.2" Roughness="1.4" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ui:SymbolIcon x:Name="IconPart" Symbol="{TemplateBinding Icon}" FontSize="16" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="ContentPart" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SketchBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="Empty">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconPart" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Success">
                            <Setter TargetName="Box" Property="Hatched" Value="True" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#17761D" />
                            <Setter Property="Foreground" Value="#062A08" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Danger">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#F0203F" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Transparent">
                            <Setter TargetName="Box" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Box" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
