<UserControl x:Class="Bloxstrap.UI.Elements.Settings.Tools.FlagToolsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PSYstrap: fast flag cleanup + profiles -->
    <StackPanel>
        <TextBlock Text="Cleanup and profiles" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IgnoredSummary, Mode=OneWay}" />

        <ui:Button Margin="0,8,0,0" Icon="Broom24" HorizontalAlignment="Left" Content="Remove the flags Roblox ignores" Command="{Binding CleanCommand}" />

        <TextBlock Margin="0,14,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Profiles save your whole flag list under a name, so you can switch between sets (like one for an AFK game and one for playing)." />

        <WrapPanel Margin="0,8,0,0">
            <ComboBox Width="200" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
            <ui:Button Margin="8,0,0,0" Icon="ArrowDownload24" Content="Load" Command="{Binding LoadProfileCommand}" />
            <ui:Button Margin="8,0,0,0" Icon="Delete24" Appearance="Transparent" ToolTip="Delete profile" AutomationProperties.Name="Delete profile" Command="{Binding DeleteProfileCommand}" />
            <ui:TextBox Margin="20,0,0,0" Width="180" PlaceholderText="New profile name" Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Margin="8,0,0,0" Icon="Save24" Content="Save current flags" Command="{Binding SaveProfileCommand}" />
        </WrapPanel>

        <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Status, Mode=OneWay}" />
    </StackPanel>
</UserControl>
