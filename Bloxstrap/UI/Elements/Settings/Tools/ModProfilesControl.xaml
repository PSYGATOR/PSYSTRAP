<UserControl x:Class="Bloxstrap.UI.Elements.Settings.Tools.ModProfilesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PSYstrap: mod profiles -->
    <StackPanel>
        <TextBlock Text="Mod profiles" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Save the mods you have now (fonts, sounds, sky, cursor...) under a name. Then on the Gameplay page, give a game profile that mod profile and it switches when you open that game. Your normal mods come back when you open anything else. Fast flags aren't part of it." />

        <WrapPanel Margin="0,8,0,0">
            <ui:TextBox Width="200" PlaceholderText="Profile name" Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Margin="8,0,0,0" Icon="Save24" Content="Save current mods" Command="{Binding SaveCommand}" />
            <ComboBox Margin="20,0,0,0" Width="200" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
            <ui:Button Margin="8,0,0,0" Icon="Delete24" Appearance="Transparent" ToolTip="Delete profile" AutomationProperties.Name="Delete profile" Command="{Binding DeleteCommand}" />
        </WrapPanel>

        <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CurrentText, Mode=OneTime}" />
        <TextBlock Margin="2,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="All Roblox windows share one Roblox folder, so with several windows open the one you launched last decides the mods." />
        <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Status, Mode=OneWay}" />
    </StackPanel>
</UserControl>
