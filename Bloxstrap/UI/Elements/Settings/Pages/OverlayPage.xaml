<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.OverlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:overlay="clr-namespace:Bloxstrap.UI.Elements.Overlay"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="OverlayPage"
      Scrollable="True">
    <!-- PSYstrap: in-game overlay / mod menu -->
    <StackPanel Margin="0,0,14,14">
        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Counters drawn on top of Roblox while you play, plus a quick menu for these settings. Press the menu key in game to open it." />
        <Border Height="3" Width="44" HorizontalAlignment="Left" CornerRadius="1.5" Margin="1,10,0,4" Background="{DynamicResource PsyCrownStripBrush}" />

        <overlay:OverlayOptionsControl />

        <TextBlock Margin="2,16,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="The overlay is its own window on top of Roblox; nothing is injected into the game. It shows in windowed and borderless fullscreen, but not exclusive fullscreen. The FPS counter needs PSYstrap to be allowed to read Windows performance events (admin, or the Performance Log Users group) and only sees the Direct3D renderer, not Vulkan or OpenGL." />
    </StackPanel>
</ui:UiPage>
