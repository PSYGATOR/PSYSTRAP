<Window x:Class="Bloxstrap.UI.Elements.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
        Title="PSYstrap Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- PSYstrap HUD: click-through stat pills drawn over the Roblox window (nothing is injected into Roblox) -->
    <Window.Resources>
        <!-- hand-drawn pills, like the logo: wobbly marker outline, marker labels, handwritten numbers -->
        <Style x:Key="Pill" TargetType="controls:SketchBorder">
            <Setter Property="Background" Value="#E00A170E" />
            <Setter Property="BorderBrush" Value="#27B52B" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Roughness" Value="1.2" />
            <Setter Property="Padding" Value="8,1,10,2" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3CF02A" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/Fonts/#Permanent Marker" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,7,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF8EC" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/Fonts/#Patrick Hand" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel x:Name="WidgetPanel" Margin="2">
        <controls:SketchBorder x:Name="FramerateWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="FPS" />
                <TextBlock x:Name="FramerateText" Style="{StaticResource Value}" Text="--" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="ClicksWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="CPS" />
                <TextBlock x:Name="ClicksText" Style="{StaticResource Value}" Text="0 | 0" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="MemoryWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="RAM" />
                <TextBlock x:Name="MemoryText" Style="{StaticResource Value}" Text="--" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="SessionWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="SESSION" />
                <TextBlock x:Name="SessionText" Style="{StaticResource Value}" Text="0:00" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="ClockWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="TIME" />
                <TextBlock x:Name="ClockText" Style="{StaticResource Value}" Text="--" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="ServerWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="SERVER" />
                <TextBlock x:Name="ServerText" Style="{StaticResource Value}" FontSize="15" Text="--" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="PlaytimeWidget" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="TODAY" />
                <TextBlock x:Name="PlaytimeText" Style="{StaticResource Value}" Text="--" />
            </StackPanel>
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="MacroWidget" Style="{StaticResource Pill}" Visibility="Collapsed">
            <TextBlock x:Name="MacroText" Style="{StaticResource Value}" FontSize="15" Text="" />
        </controls:SketchBorder>
        <controls:SketchBorder x:Name="MenuHint" Style="{StaticResource Pill}" Background="#C00A170E" BorderBrush="#E9B632">
            <TextBlock x:Name="MenuHintText" Style="{StaticResource Label}" Margin="0,1,0,0" Foreground="#F6E7A6" Text="Insert: PSYstrap menu" />
        </controls:SketchBorder>
    </StackPanel>
</Window>
