<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.MacroOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
             xmlns:vm="clr-namespace:Bloxstrap.UI.ViewModels.Overlay"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverlayOptionsViewModel}"
             d:DesignWidth="600">
    <!-- PSYstrap: macro options, shown on the Settings "Macros" and "Overlay" pages and in the in-game menu -->
    <StackPanel>
        <controls:SketchBorder Margin="0,10,0,0" Padding="16,12,16,12" CornerRadius="8"
                               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PsyCardStrokeBrush}"
                               BorderThickness="{DynamicResource PsyCardStrokeThickness}" Roughness="{DynamicResource PsySketchRoughness}">
            <StackPanel>
                <TextBlock Text="How to use" FontFamily="{DynamicResource PsyMarkerFont}" FontSize="{DynamicResource PsyCardTitleSize}" Foreground="{DynamicResource PsyCardTitleBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run FontWeight="Bold" Foreground="#5FE04C">F6</Run><Run Text=" in Roblox starts recording your keys and mouse. " />
                    <Run FontWeight="Bold" Foreground="#5FE04C">F6</Run><Run Text=" again saves it as a new macro." />
                    <LineBreak />
                    <Run FontWeight="Bold" Foreground="#5FE04C">F7</Run><Run Text=" plays the macro selected below, " />
                    <Run FontWeight="Bold" Foreground="#5FE04C">F7</Run><Run Text=" again stops it." />
                    <LineBreak />
                    <Run Text="If you click off Roblox, playback pauses so it can't type into other windows." />
                </TextBlock>
            </StackPanel>
        </controls:SketchBorder>

        <controls:SketchBorder Margin="0,10,0,0" Padding="16,12,16,12" CornerRadius="8"
                               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PsyCardStrokeBrush}"
                               BorderThickness="{DynamicResource PsyCardStrokeThickness}" Roughness="{DynamicResource PsySketchRoughness}">
            <StackPanel>
                <TextBlock Text="Macro" FontFamily="{DynamicResource PsyMarkerFont}" FontSize="{DynamicResource PsyCardTitleSize}" Foreground="{DynamicResource PsyCardTitleBrush}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SelectedMacroDetails, Mode=OneWay}" />
                <!-- controls on their own line, so the text keeps its width in the narrow in-game menu -->
                <WrapPanel Margin="0,10,0,0">
                    <ComboBox Width="200" Margin="0,0,6,6" Padding="10,5,10,5" ItemsSource="{Binding MacroNames}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" AutomationProperties.Name="Macro" />
                    <ui:Button Margin="0,0,6,6" Icon="Delete24" ToolTip="Delete this macro" AutomationProperties.Name="Delete this macro" Command="{Binding DeleteMacroCommand}" />
                    <ui:Button Margin="0,0,6,6" Icon="Folder24" ToolTip="Open the macros folder" AutomationProperties.Name="Open the macros folder" Command="{Binding OpenMacroFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </controls:SketchBorder>

        <controls:OptionControl Header="Repeat" Description="How many times F7 plays it.">
            <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding MacroRunChoices, Mode=OneTime}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MacroRuns, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Speed">
            <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding MacroSpeedChoices, Mode=OneTime}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MacroSpeed, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Smart macros" FontSize="19" FontFamily="{DynamicResource PsyMarkerFont}" Margin="0,16,0,0" />
        <TextBlock Margin="2,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Watch the screen and do stuff when something shows up, like rejoining when you get disconnected. F8 in game starts/stops the one picked here." />

        <controls:SketchBorder Margin="0,10,0,0" Padding="16,12,16,12" CornerRadius="8"
                               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PsyCardStrokeBrush}"
                               BorderThickness="{DynamicResource PsyCardStrokeThickness}" Roughness="{DynamicResource PsySketchRoughness}">
            <StackPanel>
                <TextBlock Text="Smart macro" FontFamily="{DynamicResource PsyMarkerFont}" FontSize="{DynamicResource PsyCardTitleSize}" Foreground="{DynamicResource PsyCardTitleBrush}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SelectedSmartMacroDetails, Mode=OneWay}" />
                <!-- controls on their own line, so the text keeps its width in the narrow in-game menu -->
                <WrapPanel Margin="0,10,0,0">
                    <ComboBox Width="200" Margin="0,0,6,6" Padding="10,5,10,5" ItemsSource="{Binding SmartMacroNames}" SelectedItem="{Binding SelectedSmartMacro, Mode=TwoWay}" AutomationProperties.Name="Smart macro" />
                    <ui:Button Margin="0,0,6,6" Icon="Add24" Content="New" Command="{Binding NewSmartMacroCommand}" />
                    <ui:Button Margin="0,0,6,6" Icon="Edit24" Content="Edit" Command="{Binding EditSmartMacroCommand}" />
                    <ui:Button Margin="0,0,6,6" Icon="Delete24" ToolTip="Delete" AutomationProperties.Name="Delete smart macro" Command="{Binding DeleteSmartMacroCommand}" />
                </WrapPanel>
            </StackPanel>
        </controls:SketchBorder>
    </StackPanel>
</UserControl>
