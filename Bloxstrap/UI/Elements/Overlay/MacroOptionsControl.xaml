<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.MacroOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
             xmlns:vm="clr-namespace:Bloxstrap.UI.ViewModels.Overlay"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverlayOptionsViewModel}"
             d:DesignWidth="600">
    <!-- PSYstrap: macro options, shown on the Settings "Macros" and "Overlay" pages and in the in-game menu -->
    <StackPanel>
        <ui:Card Margin="0,8,0,0">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="How to use" />
                <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run FontWeight="Bold" Foreground="#5FE04C">F6</Run><Run Text=" in Roblox starts recording your keys and mouse. " />
                    <Run FontWeight="Bold" Foreground="#5FE04C">F6</Run><Run Text=" again saves it as a new macro." />
                    <LineBreak />
                    <Run FontWeight="Bold" Foreground="#5FE04C">F7</Run><Run Text=" plays the macro selected below, " />
                    <Run FontWeight="Bold" Foreground="#5FE04C">F7</Run><Run Text=" again stops it." />
                    <LineBreak />
                    <Run Text="Playback pauses whenever Roblox isn't the focused window, so it never types into other apps." />
                </TextBlock>
            </StackPanel>
        </ui:Card>

        <controls:OptionControl Header="Macro" Description="{Binding SelectedMacroDetails, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding MacroNames}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" />
                <ui:Button Margin="6,0,0,0" Icon="Delete24" ToolTip="Delete this macro" Command="{Binding DeleteMacroCommand}" />
                <ui:Button Margin="6,0,0,0" Icon="Folder24" ToolTip="Open the macros folder" Command="{Binding OpenMacroFolderCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="Repeat" Description="How many times F7 plays it.">
            <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding MacroRunChoices, Mode=OneTime}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MacroRuns, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Speed">
            <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding MacroSpeedChoices, Mode=OneTime}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MacroSpeed, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Smart macros" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Margin="2,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Watch the Roblox window and react: &quot;when the Disconnected message is seen → rejoin&quot;, &quot;when the bag-full icon is seen → play my Sell macro&quot;. F8 in Roblox starts and stops the one selected here." />

        <controls:OptionControl Header="Smart macro" Description="{Binding SelectedSmartMacroDetails, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding SmartMacroNames}" SelectedItem="{Binding SelectedSmartMacro, Mode=TwoWay}" />
                <ui:Button Margin="6,0,0,0" Icon="Add24" Content="New" Command="{Binding NewSmartMacroCommand}" />
                <ui:Button Margin="6,0,0,0" Icon="Edit24" Content="Edit" Command="{Binding EditSmartMacroCommand}" />
                <ui:Button Margin="6,0,0,0" Icon="Delete24" ToolTip="Delete" Command="{Binding DeleteSmartMacroCommand}" />
            </StackPanel>
        </controls:OptionControl>
    </StackPanel>
</UserControl>
