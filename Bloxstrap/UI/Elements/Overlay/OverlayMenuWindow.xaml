<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Overlay.OverlayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        xmlns:overlay="clr-namespace:Bloxstrap.UI.Elements.Overlay"
        Title="PSYstrap menu"
        Width="500"
        Height="620"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="Manual">
    <!-- PSYstrap in-game menu: opened with the menu key over Roblox, closes when Roblox is clicked again -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="PSYstrap" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" Icon="pack://application:,,,/Bloxstrap.ico" KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,0,16,6">
            <Image Width="40" Height="40" Source="pack://application:,,,/Resources/BootstrapperStyles/PSY/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><RotateTransform Angle="-6" /></Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="PSYstrap" FontFamily="{DynamicResource PsyMarkerFont}" FontSize="28" Foreground="{DynamicResource PsyPageTitleBrush}" Effect="{DynamicResource PsyTitleEffect}" RenderTransformOrigin="0,1">
                <TextBlock.RenderTransform><RotateTransform Angle="{DynamicResource PsyPageTitleAngle}" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Margin="10,6,0,0" VerticalAlignment="Center" Text="menu" FontFamily="{DynamicResource PsyHandFont}" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="16,4,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Button Icon="Window24" Content="Instances and macros" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="OpenInstances_Click" />
                <overlay:OverlayOptionsControl />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="16,10" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="FooterText" FontFamily="{DynamicResource PsyHandFont}" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Changes save right away. Press Insert or click Roblox to close." TextWrapping="Wrap" />
        </Border>
    </Grid>
</base:WpfUiWindow>
