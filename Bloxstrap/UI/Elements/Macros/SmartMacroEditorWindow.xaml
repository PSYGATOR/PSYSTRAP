<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Macros.SmartMacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="PSYstrap Smart Macro"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="PSYstrap Smart Macro" Icon="pack://application:,,,/Bloxstrap.ico" />

        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- left: screenshot to click/drag on -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Icon="Camera24" Appearance="Primary" Content="Screenshot Roblox" Click="Capture_Click" />
                    <ui:Button Margin="6,0,0,0" Icon="Image24" Content="Open image" Command="{Binding LoadImageCommand}" />
                    <RadioButton Margin="16,0,0,0" VerticalAlignment="Center" Content="Click = pixel check" IsChecked="{Binding PixelMode, Mode=TwoWay}" />
                    <RadioButton Margin="10,0,0,0" VerticalAlignment="Center" Content="Drag = picture check" IsChecked="{Binding ImageMode, Mode=TwoWay}" />
                    <RadioButton Margin="10,0,0,0" VerticalAlignment="Center" Content="Drag = text check" IsChecked="{Binding TextMode, Mode=TwoWay}" />
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="6" Background="#40000000" ClipToBounds="True">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding NoScreenshotVisibility, Mode=OneWay}"
                                   Text="Get Roblox to the screen you want to react to (e.g. the disconnected message), then press Screenshot Roblox." />
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ScreenshotImage" Source="{Binding Screenshot, Mode=OneWay}" Stretch="Uniform" Cursor="Cross"
                                   MouseLeftButtonDown="Screenshot_MouseDown" MouseMove="Screenshot_MouseMove" MouseLeftButtonUp="Screenshot_MouseUp" />
                            <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status, Mode=OneWay}" />
            </Grid>

            <!-- right: detectors and rules -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Name" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontSize="12" Text="Check every" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Margin="6,0" Width="64" Text="{Binding IntervalMs, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Text="ms" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="Medium" Text="Detectors" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Icon="CheckmarkCircle24" Content="Test" Command="{Binding TestCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Detectors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,4,0,0" Padding="10,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="Delete24" Command="{Binding RemoveCommand}" />
                                        </Grid>
                                        <TextBlock Margin="2,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Summary}" />
                                        <ui:TextBox Margin="0,4,0,0" PlaceholderText="Text to look for, e.g. Disconnected" Visibility="{Binding TextVisibility}"
                                                    Text="{Binding ExpectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="2,4,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#5FE04C" Visibility="{Binding TextVisibility}" Text="{Binding TestResult}" />
                                        <StackPanel Orientation="Horizontal" Margin="2,4,0,0" Visibility="{Binding SensitivityVisibility}">
                                            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SensitivityLabel}" />
                                            <ui:TextBox Margin="6,0,0,0" Width="60" Text="{Binding Sensitivity, Mode=TwoWay}" />
                                            <TextBlock Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#5FE04C" Text="{Binding TestResult}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="Medium" Text="Rules" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Checked top to bottom; the first one that's ready fires." />
                        </StackPanel>
                        <ui:Button Grid.Column="1" VerticalAlignment="Top" Icon="Add24" Content="Add rule" Command="{Binding AddRuleCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,4,0,0" Padding="10,8">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="When" />
                                            <ComboBox Width="130" ItemsSource="{Binding Detectors}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDetector, Mode=TwoWay}" />
                                            <ComboBox Margin="6,0,0,0" Width="96" ItemsSource="{Binding ConditionChoices, Mode=OneTime}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding WhenSeen, Mode=TwoWay}" />
                                            <TextBlock VerticalAlignment="Center" Margin="6,0" Text="for" />
                                            <ui:TextBox Width="48" Text="{Binding ForSeconds, Mode=TwoWay}" />
                                            <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" Text="s" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="→" />
                                            <ComboBox Width="150" ItemsSource="{Binding Actions, Mode=OneTime}" SelectedItem="{Binding Action, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Margin="6,0,0,0" Width="140" IsEditable="True" ToolTip="{Binding ParameterHint}" ItemsSource="{Binding MacroNames}"
                                                      Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Visibility="{Binding ParameterVisibility}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Wait at least" />
                                            <ui:TextBox Margin="6,0" Width="48" Text="{Binding CooldownSeconds, Mode=TwoWay}" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="s before firing again" />
                                            <ui:Button Margin="12,0,0,0" Icon="ArrowUp24" ToolTip="Move up" Command="{Binding MoveUpCommand}" />
                                            <ui:Button Margin="4,0,0,0" Icon="Delete24" ToolTip="Remove rule" Command="{Binding RemoveCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="16,10" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="In Roblox, F8 starts and stops the smart macro selected on the Macros page. It pauses whenever Roblox isn't focused, and needs the Roblox window visible." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Primary" Content="Save" Click="Save_Click" />
                    <ui:Button Margin="8,0,0,0" Content="Cancel" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
